# Corporate proxy for voxsol. Copy to secrets/proxy.env (gitignored), or let the helper write it:
#   scripts/proxy.sh set http://proxy.example.com:8080 --no-proxy "localhost,127.0.0.1,.corp.local" --ca /path/to/root-ca.pem
# Read by env.sh (shell, pip, git, curl), .Rprofile (R, install.packages), setup.sh and the voxsol CLI
# (CAMS / CDS downloads). Values here override proxy variables inherited from the system.
# Credentials in the URL must be URL-encoded, e.g. @ -> %40, # -> %23:  http://user:p%40ss@proxy.example.com:8080
HTTP_PROXY=http://proxy.example.com:8080
HTTPS_PROXY=http://proxy.example.com:8080
NO_PROXY=localhost,127.0.0.1

# Optional: corporate root CA (PEM) for proxies with TLS inspection. It is appended to the system CA
# bundle into .cache/ca-bundle.pem, which Python (requests, pip), R (libcurl), git and curl then use.
# If IT already installed the CA system-wide, point to the system bundle so Python trusts it too:
#   CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
#CA_BUNDLE=/path/to/corporate-root-ca.pem
